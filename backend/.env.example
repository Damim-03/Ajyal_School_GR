# ======================================================
# نسخة توضيحية — انسخها إلى .env واملأ القيم
#   cp .env.example .env
# ======================================================

# --------------------------------------------------
# Server
# --------------------------------------------------
NODE_ENV=development
PORT=3001
BASE_PATH=/api

# --------------------------------------------------
# Database — MySQL / MariaDB
# مصدر وحيد للاتصال: يستعمله Prisma CLI و runtime معاً
#
# إذا كانت كلمة المرور تحتوي رموزاً خاصة (@ : / ?) فرمّزها URL-encoding
#   مثال: p@ss  →  p%40ss
# --------------------------------------------------
DATABASE_URL="mysql://ajyal_app:066060088@127.0.0.1:3307/ajyal_sch"

# --------------------------------------------------
# JWT — غيّرها إلزامياً في الإنتاج
# ولّد قيمة عشوائية: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# --------------------------------------------------
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --------------------------------------------------
# CORS — أصل تطبيق Tauri
# --------------------------------------------------
FRONTEND_ORIGIN=tauri://localhost

# --------------------------------------------------
# Seeder — حساب المدير الأول (npm run seed)
# إذا تُركت SEED_ADMIN_PASSWORD فارغة سيولّد السكربت كلمة مرور
# عشوائية ويعرضها مرة واحدة في الطرفية
# --------------------------------------------------
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FIRST_NAME=System
SEED_ADMIN_LAST_NAME=Administrator
SEED_ADMIN_EMAIL=

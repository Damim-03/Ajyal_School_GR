{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "Node16",
    "moduleResolution": "node16",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "types": ["node"],
    "typeRoots": ["./src/@Types", "./node_modules/@types"]
  },
  "include": ["src/**/*"],
  "//": "الاختبارات خارج بناء الإنتاج — لا تُرفع إلى الخادم. تُفحص أنواعُها في tsconfig.test.json",
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"],
  "ts-node": {
    "files": true
  }
}
